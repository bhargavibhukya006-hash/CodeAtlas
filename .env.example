# CodeAtlas Root Environment Variables
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://codeatlas:codeatlas_secret@localhost:5432/codeatlas_db

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# GitHub API Configuration (Optional for public repositories, increases rate limit)
GITHUB_TOKEN=your_github_token_here

# Semantic Retrieval & Limits
TOP_K=8
MAX_FILE_SIZE=200000
MAX_FILES=500
MAX_EMBEDDING_BATCH_SIZE=100

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
